---
// Rankings (BRIEF, Fase 2): mais dividida, mais unânime, maior virada e capitais. As listas vêm de /data/rankings.json em
// tempo de execução (ilha components/rankings.ts); o HTML estático é só a moldura, com linhas de espera do tamanho das
// reais, para a página não pular quando os nomes chegam. No modo pre as listas dão lugar à contagem regressiva do Painel
// (a mesma da home) e a uma frase com a hora de início.
import statusFixture from '../../../contracts/fixtures/status.json';
import Botao from '../components/Botao.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Painel from '../components/Painel.astro';
import Rodape from '../components/Rodape.astro';
import Base from '../layouts/Base.astro';
import { ROTULO_RANKING, descricaoRankings, listasAbrem, tituloRankings } from '../lib/copy.ts';
import { ajustarDestino } from '../lib/destino.ts';
import { parseStatus } from '../lib/status.ts';

const status = parseStatus(statusFixture);
// Build em modo pre: o bloco do pre já sai no HTML (sem listas de espera que sumiriam e empurrariam o rodapé). A ilha confirma
// o modo em /data/status.json e vira as listas quando a apuração começa.
const pre = status.modo === 'pre';

// DESTINO do título: ajustado no build numa largura de referência e escrito em cqi, então encosta na margem em qualquer
// largura, sem JS. Nome curto fica no tamanho máximo, em wdth 125, alinhado à esquerda.
const REFERENCIA = 1000;
const [faixa] = ajustarDestino('RANKINGS', { largura: REFERENCIA, tamMax: 150, tamMin: 60, maxLinhas: 1 }).linhas;
const estiloTitulo = `--t:${(faixa.tamanho / REFERENCIA) * 100}cqi;--w:${faixa.wdth}%`;

const indice = Object.values(ROTULO_RANKING).join(' · ');

const secoes = Object.entries(ROTULO_RANKING).map(([chave, rotulo]) => ({
  chave,
  rotulo,
  // O tamanho das listas reais: 27 capitais e o topo 10 de cada ranking.
  espera: chave === 'capitais' ? 27 : 10,
}));
---

<Base titulo={tituloRankings} descricao={descricaoRankings} caminho="/rankings">
  <div class="pagina">
    <Cabecalho modo={status.modo} />

    <main>
      <h1 class="destino"><span class="linha" style={estiloTitulo}>Rankings</span></h1>

      <div class="ilha" data-rankings>
        <div class="pre" hidden={!pre} data-rk-pre>
          <div class="texto">
            <p class="frase">{listasAbrem(status.inicio)}</p>
            <p class="indice">{indice}</p>
          </div>
          <div class="contagem">
            <Painel inicio={status.inicio} />
          </div>
        </div>
        <p class="aviso" role="status" hidden data-rk-aviso></p>
        {!pre && <noscript><p class="aviso">Os rankings precisam de JavaScript para carregar.</p></noscript>}

        {
          secoes.map(({ chave, rotulo, espera }) => (
            <section class={`secao ${chave}`} aria-labelledby={`rk-${chave}`} data-rk-secao={chave} hidden={pre}>
              <h2 class="titulo" id={`rk-${chave}`}>
                {rotulo}
              </h2>
              <ol class="lista" data-rk-lista={chave}>
                {Array.from({ length: espera }, () => (
                  <li class="esqueleto" aria-hidden="true" />
                ))}
              </ol>
            </section>
          ))
        }
      </div>

      <p class="fim">
        <Botao href="/" variante="secundario">Buscar sua cidade</Botao>
      </p>
    </main>

    <Rodape />
  </div>
</Base>

<script>
  import '../components/rankings.ts';
</script>

<style>
  /* No pre a página é curta: o rodapé fica na borda de baixo da janela em vez de no meio dela. */
  .pagina {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--sp-2);
  }

  main {
    flex: 1;
  }

  .destino {
    container-type: inline-size;
    padding-top: var(--sp-1);
    line-height: 0.9;
    text-transform: uppercase;
    overflow-x: clip;
  }

  .linha {
    display: block;
    font-size: var(--t);
    font-stretch: var(--w);
    white-space: nowrap;
  }

  .ilha {
    display: grid;
    gap: var(--sp-5) var(--sp-3);
    align-items: start;
    padding-block: var(--sp-4) var(--sp-5);
  }

  /* Pre: a frase, o índice das listas e a contagem regressiva do Painel (a da home) são a página. */
  .pre {
    grid-column: 1 / -1;
    display: grid;
    align-items: start;
    gap: var(--sp-4) var(--sp-3);
    padding-top: var(--sp-2);
    border-top: var(--stroke-2) solid var(--ink);
  }

  .pre[hidden] {
    display: none;
  }

  .texto {
    display: grid;
    gap: var(--sp-2);
  }

  .frase {
    font-family: var(--font-display);
    font-size: var(--fs-4);
    font-weight: 900;
    font-stretch: 75%;
    line-height: 1.05;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .indice {
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* Erro de rede: uma faixa discreta, como o aviso de dados fictícios do rodapé. */
  .aviso {
    grid-column: 1 / -1;
    padding: var(--sp-1) var(--sp-2);
    border: var(--stroke-1) solid var(--ink-2);
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 900;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .secao[hidden] {
    display: none;
  }

  .titulo {
    padding-top: var(--sp-1);
    border-top: var(--stroke-2) solid var(--ink);
    font-size: var(--fs-3);
    font-stretch: 87.5%;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  .lista {
    display: grid;
    margin: var(--sp-1) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Linha de destino compacta: posição em placa, nome ajustado à coluna pelo eixo wdth (estilo vindo de rankings.ts) e a
     sigla da UF. As linhas são criadas pela ilha, por isso :global. */
  .lista :global(.item) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    min-height: 56px;
    padding-block: var(--sp-1);
    border-bottom: var(--stroke-1) solid var(--surface-2);
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .lista :global(.item.primeiro) {
    min-height: 72px;
  }

  /* Colunas fixas: sem a posição (capitais), a caixa do nome continua na coluna do meio. */
  .lista :global(.pos) {
    grid-column: 1;
    display: grid;
    place-items: center;
    min-width: var(--sp-4);
    height: var(--sp-4);
    margin-right: var(--sp-2);
    background: var(--ink);
    font-family: var(--font-display);
    font-size: var(--fs-2);
    font-weight: 900;
    line-height: 1;
    color: var(--bg);
  }

  /* A caixa do nome é o container do ajuste: o font-size em cqi vem dela, e a altura é a da letra. */
  .lista :global(.caixa) {
    grid-column: 2;
    container-type: inline-size;
    min-width: 0;
  }

  .lista :global(.nome) {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .lista :global(.uf) {
    grid-column: 3;
    display: grid;
    place-items: center;
    min-width: var(--sp-5);
    min-height: var(--sp-3);
    margin-left: var(--sp-2);
    border: var(--stroke-1) solid var(--ink-2);
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 900;
    letter-spacing: var(--track-caps);
    color: var(--ink-2);
  }

  @media (hover: hover) {
    .lista :global(.item:hover) {
      background: var(--surface-1);
    }

    .lista :global(.item:hover .nome) {
      text-decoration: underline;
      text-decoration-thickness: var(--stroke-2);
      text-underline-offset: 0.12em;
    }
  }

  .lista :global(.item:active) {
    transform: translateY(1px);
  }

  .lista :global(.vazio) {
    padding-block: var(--sp-2);
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 900;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* Espera: barras do tamanho das linhas reais, sem animação (nada que pisque enquanto a rede responde). */
  .esqueleto {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-bottom: var(--stroke-1) solid var(--surface-2);
  }

  .esqueleto::before {
    content: '';
    width: 60%;
    height: var(--sp-3);
    background: var(--surface-2);
  }

  .fim {
    padding-bottom: var(--sp-7);
  }

  @media (min-width: 768px) {
    .pagina {
      padding-inline: var(--sp-4);
    }

    .ilha {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .capitais {
      grid-column: 1 / -1;
    }

    .capitais .lista {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      column-gap: var(--sp-3);
    }
  }

  @media (min-width: 1024px) {
    .pagina {
      padding-inline: var(--sp-6);
    }

    .ilha {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pre {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .texto {
      grid-column: 1 / span 5;
    }

    .contagem {
      grid-column: 7 / span 6;
    }
  }
</style>
