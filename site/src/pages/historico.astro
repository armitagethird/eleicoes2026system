---
// Histórico (decisão do Romero, 06/10): gráfico de linha comparando as eleições presidenciais de 2018, 2022 e 2026. O modo
// vem de contracts/fixtures/status.json no build; a ilha confirma em /data/status.json e liga o 2º turno de 2026 ao vivo
// quando a apuração começa.
import statusFixture from '../../../contracts/fixtures/status.json';
import Cabecalho from '../components/Cabecalho.astro';
import Historico from '../components/historico/Historico.astro';
import Rodape from '../components/Rodape.astro';
import Base from '../layouts/Base.astro';
import { descricaoHistorico, tituloHistorico } from '../lib/copy.ts';
import { parseStatus } from '../lib/status.ts';

const status = parseStatus(statusFixture);
---

<Base titulo={tituloHistorico} descricao={descricaoHistorico} caminho="/historico">
  <div class="pagina">
    <Cabecalho modo={status.modo} />
    <main>
      <Historico status={status} />
    </main>
    <Rodape />
  </div>
</Base>

<style>
  .pagina {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--sp-2);
  }

  main {
    padding-bottom: var(--sp-6);
  }

  @media (min-width: 768px) {
    .pagina {
      padding-inline: var(--sp-4);
    }
  }

  @media (min-width: 1024px) {
    .pagina {
      padding-inline: var(--sp-6);
    }
  }
</style>
