---
// Rodapé: fonte dos números e a marca numa linha só e, enquanto as fixtures estiverem no ar, o aviso de dados fictícios.
// O link para os rankings fica no cabeçalho.
import { AVISO_FICTICIO, FONTE_TSE } from '../lib/copy.ts';
import { SITE_NAME } from '../lib/site.ts';

interface Props {
  /** Liga o aviso de dados fictícios. Padrão ligado: esquecer de desligar é melhor do que publicar fixture como resultado. */
  ficticio?: boolean;
}

const { ficticio = true } = Astro.props;
---

<footer class="rodape">
  {ficticio && <p class="aviso">{AVISO_FICTICIO}</p>}
  <div class="linha">
    <p class="fonte">{FONTE_TSE}</p>
    <p class="marca">{SITE_NAME}</p>
  </div>
</footer>

<style>
  .rodape {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-3) var(--sp-5);
    border-top: var(--stroke-2) solid var(--ink);
  }

  .aviso {
    padding: var(--sp-1) var(--sp-2);
    border: var(--stroke-1) solid var(--ink-2);
    color: var(--ink);
    font-size: var(--fs-1);
  }

  .linha {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-1) var(--sp-2);
  }

  .fonte,
  .marca {
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 900;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .marca {
    font-stretch: 125%;
  }
</style>
