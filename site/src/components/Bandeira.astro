---
// Bandeira intacta numa caixa fixa 10:7 (proporção da bandeira do Brasil). Cada raster tem a proporção da própria
// bandeira e fica inteiro dentro da caixa (object-fit: contain): nunca recorte, filtro, opacidade, fundo ou
// distorção (Lei 5.700/1971). Os WebP vêm do SVG oficial renderizado no Chrome (npm run flags:raster).
import type { UF } from '../lib/contratos.ts';
import { altBandeira, rasterBandeira } from '../lib/bandeiras.ts';

interface Props {
  /** Sigla minúscula da UF ou "br". */
  uf: Lowercase<UF> | 'br';
  /** Largura da caixa em px CSS; a altura é largura × 0,7. */
  largura?: number;
  carregamento?: 'lazy' | 'eager';
  /** Dentro de um link ou rótulo que já diz de qual lugar é: alt vazio, para o nome acessível não ganhar "Bandeira do ..." (WCAG 2.5.3). */
  decorativa?: boolean;
}

const { uf, largura = 40, carregamento = 'lazy', decorativa = false } = Astro.props;
const { src, srcset } = rasterBandeira(uf, largura);
const altura = Math.round(largura * 0.7);
---

<img
  class="bandeira"
  src={src}
  srcset={srcset}
  alt={decorativa ? '' : altBandeira(uf)}
  width={largura}
  height={altura}
  loading={carregamento}
  fetchpriority={carregamento === 'eager' ? 'high' : undefined}
  decoding="async"
/>

<style>
  .bandeira {
    object-fit: contain;
    flex: none;
  }
</style>
