---
// Bandeira intacta numa caixa fixa 10:7 (proporção da bandeira do Brasil). Bandeiras com outra proporção
// ficam inteiras dentro da caixa (object-fit: contain): nunca recorte, filtro, fundo ou distorção (Lei 5.700/1971).
// PROVISÓRIO: serve o SVG otimizado; o raster gerado a partir do SVG oficial substitui o src mantendo esta interface.
import { NOME_UF, type UF } from '../lib/contratos.ts';

interface Props {
  /** Sigla minúscula da UF ou "br". */
  uf: Lowercase<UF> | 'br';
  /** Largura da caixa em px CSS; a altura é largura × 0,7. */
  largura?: number;
  carregamento?: 'lazy' | 'eager';
}

const { uf, largura = 40, carregamento = 'lazy' } = Astro.props;
const arquivos = import.meta.glob<string>('../assets/flags/*.svg', { eager: true, query: '?url', import: 'default' });
const src = arquivos[`../assets/flags/${uf}.svg`];
const nome = uf === 'br' ? 'Brasil' : NOME_UF[uf.toUpperCase() as UF];
const altura = Math.round(largura * 0.7);
---

<img
  class="bandeira"
  src={src}
  alt={`Bandeira ${uf === 'br' ? 'do Brasil' : `de ${nome}`}`}
  width={largura}
  height={altura}
  loading={carregamento}
  decoding="async"
/>

<style>
  .bandeira {
    object-fit: contain;
    flex: none;
  }
</style>
