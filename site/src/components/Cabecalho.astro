---
// Cabeçalho do site: wordmark (900, wdth 125, caixa-alta), a pílula de estado e a navegação (apuração e histórico)
// (design/DIRECTION.md, Home). O indicador "ao vivo" não usa acento (só do selo) nem cor de candidato: é --ink.
import { pilula } from '../lib/copy.ts';
import { SITE_NAME } from '../lib/site.ts';
import type { Modo } from '../lib/status.ts';

interface Props {
  modo: Modo;
  /** live/final: seções apuradas do placar BR. */
  secoesPct?: number;
  /** live/final: hora da última atualização (ISO 8601). */
  atualizado?: string | null;
}

const { modo, secoesPct, atualizado } = Astro.props;
const { pathname } = Astro.url;
// O ano no fim do nome ("Placar 2026") sai em amarelo: o toque de Brasil do wordmark. Nome sem ano fica todo em --ink.
const [, nome, ano] = SITE_NAME.match(/^(.*?)(\d{4})$/) ?? [SITE_NAME, SITE_NAME, ''];
const links = [
  { href: '/apuracao', texto: 'Apuração' },
  { href: '/historico', texto: 'Histórico' },
];
---

<header class="cabecalho">
  <a class="marca" href="/" aria-current={pathname === '/' ? 'page' : undefined}><span>{nome}{ano && <span class="ano">{ano}</span>}</span></a>
  <p class="pilula" data-modo={modo}>
    <span class="sinal" aria-hidden="true"></span>
    <span data-pilula>{pilula(modo, secoesPct, atualizado)}</span>
  </p>
  <nav aria-label="Principal">
    {
      links.map(({ href, texto }) => (
        <a class="link" href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>
          {texto}
        </a>
      ))
    }
  </nav>
</header>

<style>
  /* Celular: wordmark e link na primeira linha, a pílula embaixo. A partir de 720 px tudo cabe numa linha só. */
  .cabecalho {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'marca nav'
      'pilula pilula';
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
    padding-block: var(--sp-1);
  }

  /* Os links têm 44 px de altura (alvo de toque do projeto) sem aumentar a letra. */
  .marca,
  .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .marca {
    grid-area: marca;
    justify-self: start;
    font-size: var(--fs-3);
    font-stretch: 125%;
    text-decoration: none;
  }

  .ano {
    color: var(--amarelo);
  }

  /* Até 899 px os links vão no menor tamanho de rótulo, no wdth 62 e sem tracking: a 360 px dividem a primeira linha
     com a marca, e de 720 a 899 px cabem na linha única junto com a marca e a pílula. */
  .link {
    font-size: var(--fs-1);
    font-stretch: 62%;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .link[aria-current='page'] {
    text-decoration-color: var(--ink-2);
  }

  @media (hover: hover) {
    .link:hover {
      text-decoration-color: var(--ink-2);
    }
  }

  nav {
    grid-area: nav;
    display: flex;
    gap: var(--sp-1);
  }

  @media (min-width: 900px) {
    .link {
      font-size: var(--fs-2);
      font-stretch: 87.5%;
      letter-spacing: var(--track-caps);
    }

    nav {
      gap: var(--sp-2);
    }
  }

  /* Indicador de estado, não controle: reto como as folhas e as placas (o raio de 8 px é só dos controles). */
  .pilula {
    grid-area: pilula;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: 32px;
    padding-inline: var(--sp-1);
    border: var(--stroke-1) solid var(--ink-2);
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 900;
    font-stretch: 87.5%;
    line-height: 1;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pilula[data-modo='live'] {
    border-color: var(--ink);
  }

  /* Placa quadrada que pisca em degrau, como lâmpada de painel. Três piscadas e fica acesa: o texto "ao vivo" já diz o
     estado, e piscar sem parar por mais de 5 s não tem como pausar (WCAG 2.2.2). Está sempre no HTML, porque a página vira
     ao vivo no cliente (data-modo muda em AoVivo.ts) e a animação começa quando ela aparece. */
  .sinal {
    width: var(--sp-1);
    height: var(--sp-1);
    background: var(--ink);
    animation: pisca 1.2s steps(1, end) 3;
  }

  .pilula:not([data-modo='live']) .sinal {
    display: none;
  }

  @keyframes pisca {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 720px) {
    .cabecalho {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'marca pilula nav';
      column-gap: var(--sp-3);
    }

    .pilula {
      justify-self: end;
    }
  }
</style>
