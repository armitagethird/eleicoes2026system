# Dados ao vivo: o front faz polling a cada 20 s; cache de borda curto e revalidação obrigatória.
/data/*
  Cache-Control: public, max-age=15, must-revalidate

# Índice da busca: só muda a cada build.
/busca.json
  Cache-Control: public, max-age=3600

# Dados estáticos do mapa e do histórico: só mudam a cada build, e o nome não leva hash (por isso uma hora, não um ano).
# Sem isto, cada visita a /apuracao rebaixava uns 330 KB (gzip). As páginas HTML ficam no padrão do Pages (revalidar).
/geo/*
  Cache-Control: public, max-age=3600
/mapa/*
  Cache-Control: public, max-age=3600
/historico/*
  Cache-Control: public, max-age=3600

# Segurança básica em tudo: sem sniffing de tipo, referrer só de origem em saída para outro site, geolocalização só para o
# próprio site (a busca "usar minha localização") e a página não entra em iframe de terceiros (clickjacking).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: frame-ancestors 'none'

# Assets com hash no nome: cache eterno.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes auto-hospedadas: trocar uma fonte = trocar o NOME do arquivo (senão o cache eterno a mantém).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
